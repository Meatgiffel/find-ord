{
  "name": "find-ord",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint src scripts vite.config.ts svelte.config.js",
    "test": "vitest run src/shared src/web src/server/migrations.test.ts src/server/campaigns.test.ts src/server/game-sync.test.ts src/server/http-auth.test.ts",
    "test:generator": "tsx scripts/validate-generator.ts",
    "import:words": "tsx scripts/import-words.ts",
    "bootstrap": "tsx scripts/bootstrap.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "better-auth": "1.7.10",
    "better-sqlite3": "^12.4.1",
    "dexie": "4.4.6",
    "express": "^4.21.2",
    "svelte": "5.57.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.6",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "svelte-check": "^4.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2",
    "vite": "7.3.7",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
