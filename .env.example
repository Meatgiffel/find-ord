# Kopiér til .env og tilpas adressen til din installation.
BASE_URL=http://localhost:3000
FIND_ORD_BIND=127.0.0.1
FIND_ORD_PORT=3000

# Valgfrit: "error" logger kun fejl. Antal nye baner/kampagnepåfyldninger pr. konto pr. 10 minutter.
# LOG_LEVEL=info
# GAME_CREATION_LIMIT=60
# Banegenerering: job i køen, ms pr. forsøg (højst 3 forsøg) og antal cachede baner.
# GENERATION_QUEUE_LIMIT=8
# GENERATION_TIMEOUT_MS=3000
# PUZZLE_CACHE_LIMIT=300
# Bag en reverse proxy: proxyens adresse eller net, så loginbegrænsning gælder pr. klient.
# TRUST_PROXY=192.168.50.0/24

# Kun hvis du bevidst tilbyder en separat HTTP-adresse på et betroet lokalnet.
# LAN_HTTP_URL=http://ord.example.test:3000
# TRUSTED_ORIGINS=https://ord.example.test
